  _data:
    _json: '{"graph":{"variables":{"Kind":"Flow","collection":{"$content":[],"$version":"A"},"$version":"A"},"controlInputDefinitions":[],"controlOutputDefinitions":[],"valueInputDefinitions":[],"valueOutputDefinitions":[],"title":null,"summary":"\t\t","pan":{"x":4886.236,"y":159.9783},"zoom":0.33,"elements":[{"coroutine":false,"defaultValues":{},"position":{"x":3620.0,"y":-6.0},"guid":"c0c39ef2-32f7-48fc-bb15-d058d893b3fb","$version":"A","$type":"Visual_Scripting.OnboardingSetup","$id":"9"},{"defaultValues":{"Instructions":{"$content":"Now lay in the intake camshaft.","$type":"System.String"},"Progress percentage":{"$content":70,"$type":"System.Int32"}},"position":{"x":18382.0,"y":682.0},"guid":"84c6b0d4-5aed-49bc-b7b6-7b75eb8a6355","$version":"A","$type":"Visual_Scripting.Instructions","$id":"11"},{"defaultValues":{"Insights":{"$content":"Hey there, welcome to the workshop! This is one cylinder of a four-stroke petrol engine, cut open so you can look inside. Interact with it to take it apart!","$type":"System.String"},"Audio clip":{"$content":0,"$type":"UnityEngine.Object"},"Image":{"$content":1,"$type":"UnityEngine.Object"}},"position":{"x":3972.0,"y":-6.0},"guid":"3e62c3ff-2259-4660-801a-042cfb2bbd3e","$version":"A","$type":"Visual_Scripting.Insights","$id":"13"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":4418.0,"y":-6.0},"guid":"b94caf40-1bbe-4989-8b2b-c9256359b3bb","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"15"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to take it apart.","$type":"System.String"},"Progress percentage":{"$content":4,"$type":"System.Int32"}},"position":{"x":4814.0,"y":-6.0},"guid":"40593544-ffef-49fe-a2e2-ed7b35928c5d","$version":"A","$type":"Visual_Scripting.Instructions","$id":"17"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine","$type":"System.String"}},"position":{"x":5272.0,"y":-6.0},"guid":"1e492d86-f85d-4eb1-8204-6934ef7b6dee","$version":"A","$type":"Visual_Scripting.Action","$id":"19"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to take it apart.","$type":"System.String"}},"position":{"x":5687.0,"y":269.0},"guid":"e21cd96c-d3f2-4226-88f5-e66c04c0003a","$version":"A","$type":"Visual_Scripting.Feedback","$id":"21"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":5791.0,"y":-177.0},"guid":"0d6e2651-cd32-4275-929f-e0692116469b","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"23"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (take apart)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":5786.0,"y":36.0},"guid":"cf8f095b-a412-4f32-bcbe-90a0710ef1b1","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"25"},{"defaultValues":{"Insights":{"$content":"Here are all the parts: the crankshaft, the connecting rod, the piston, two valves, two camshafts and the spark plug. Okay, let''s start with the crankshaft!","$type":"System.String"},"Audio clip":{"$content":2,"$type":"UnityEngine.Object"},"Image":{"$content":3,"$type":"UnityEngine.Object"}},"position":{"x":6201.0,"y":27.0},"guid":"3194a09a-2648-4f9e-8da5-f9b756e75e73","$version":"A","$type":"Visual_Scripting.Insights","$id":"27"},{"defaultValues":{"duration":{"$content":6.1,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":6647.0,"y":27.0},"guid":"1583afb3-9d8a-4b84-be06-fd624565e996","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"29"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (take apart)","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":6973.0,"y":-780.0},"guid":"feb9d78f-f9af-4944-985f-8fce6641f535","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"31"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine block","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6976.0,"y":-578.0},"guid":"9f1c2dcb-37d1-482c-b5f4-0a120aebd651","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"33"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Connecting rod","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.0,"y":0.171001,"z":-1.3E-05,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":10166.0,"y":0.0},"guid":"7a40660b-0850-47fc-8309-fdc026509701","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"35"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Connecting rod","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6966.0,"y":-182.0},"guid":"452e25c2-754d-492b-a8d0-ee13e15bd277","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"37"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Intake valve","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6960.0,"y":204.0},"guid":"d65f09b9-d66e-4409-9201-eec6232cc54b","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"39"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Exhaust valve","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6953.0,"y":398.0},"guid":"c9b98755-6806-4113-9c71-92a81ba3227c","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"41"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Intake camshaft","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6944.0,"y":591.0},"guid":"88ed87fc-ae93-48cc-9cc3-853077ba08e5","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"43"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Exhaust camshaft","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6941.0,"y":792.0},"guid":"5971fb79-9a15-4e94-9e49-cf9425e1731e","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"45"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Spark plug","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6936.0,"y":987.0},"guid":"f8fcba30-4c76-438a-bf50-995d3c9601c7","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"47"},{"defaultValues":{"Instructions":{"$content":"Put the crankshaft into the bottom of the engine block.","$type":"System.String"},"Progress percentage":{"$content":10,"$type":"System.Int32"}},"position":{"x":7383.0,"y":0.0},"guid":"7dcbd445-6382-4202-9f34-cee7da081432","$version":"A","$type":"Visual_Scripting.Instructions","$id":"49"},{"actionChoice":"Combination","defaultValues":{"Correct grabbed object":{"$content":"Crankshaft","$type":"System.String"},"Correct stationary object":{"$content":"Engine block","$type":"System.String"}},"position":{"x":7842.0,"y":0.0},"guid":"fbdcc143-7a81-460b-a077-65ff46140b37","$version":"A","$type":"Visual_Scripting.Action","$id":"51"},{"defaultValues":{"Header text":{"$content":"The crankshaft comes first","$type":"System.String"},"Feedback text":{"$content":"It''s the heavy shaft with the two pear-shaped weights. It turns at the very bottom of the block, so combine it with the engine block.","$type":"System.String"}},"position":{"x":8316.0,"y":285.0},"guid":"0f45306a-625f-4204-8c2d-f38d2571de54","$version":"A","$type":"Visual_Scripting.Feedback","$id":"53"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Crankshaft","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.0,"y":0.078471,"z":-0.004,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":8319.5,"y":0.0},"guid":"4b811fd5-3bd7-4496-9679-8a634f54a14d","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"55"},{"defaultValues":{"Insights":{"$content":"Nice fit! The crankshaft spins on its main journals, and that offset crankpin goes round in circles, just like a bike pedal.","$type":"System.String"},"Audio clip":{"$content":4,"$type":"UnityEngine.Object"},"Image":{"$content":5,"$type":"UnityEngine.Object"}},"position":{"x":8758.0,"y":0.0},"guid":"6616fe91-17f1-4ee0-8be1-584934f60963","$version":"A","$type":"Visual_Scripting.Insights","$id":"57"},{"defaultValues":{"Instructions":{"$content":"Fit the connecting rod onto the crankpin.","$type":"System.String"},"Progress percentage":{"$content":20,"$type":"System.Int32"}},"position":{"x":9204.0,"y":0.0},"guid":"f44ab139-9b92-4228-ace9-f22828de3664","$version":"A","$type":"Visual_Scripting.Instructions","$id":"59"},{"actionChoice":"Combination","actionCount":2,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Connecting rod","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Connecting rod","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Crankshaft","$type":"System.String"}},"position":{"x":9663.0,"y":0.0},"guid":"31259965-c637-4e26-86b5-938ff56035b0","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"61"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Piston","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6961.0,"y":10.0},"guid":"f1445538-627d-459c-b627-24d551fd746f","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"63"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"What do the connecting rod and the crankshaft do together?","$type":"System.String"},"1st Correct answer":{"$content":"Turn the piston''s up-and-down motion into rotation","$type":"System.String"},"1st Correct answer feedback":{"$content":"Exactly! The rod pushes the crankpin round in a circle, like your leg on a bike pedal.","$type":"System.String"},"1st Wrong answer":{"$content":"Open and close the valves","$type":"System.String"},"1st Wrong answer feedback":{"$content":"Not quite. That''s the camshafts'' job, and they come later.","$type":"System.String"},"2nd Wrong answer":{"$content":"Cool the cylinder","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"Nope. Cooling is done by the coolant channels, the water jacket, in the block.","$type":"System.String"}},"position":{"x":10604.5,"y":0.0},"guid":"01f302c1-0259-4b23-9481-8a1c32be0074","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"65"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Crankshaft","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":6971.0,"y":-382.0},"guid":"cde4b797-f3dd-45c3-b870-f691a101b5a0","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"67"},{"actionChoice":"Combination","actionCount":2,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Piston","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Piston","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Connecting rod","$type":"System.String"}},"position":{"x":11679.0,"y":0.0},"guid":"e4b7db54-df45-4619-b0aa-4ee2300b4b0b","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"69"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Exhaust valve","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.039657,"y":0.317097,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":16529.0,"y":0.0},"guid":"2d190c5e-dfb5-436c-bd3a-4a7d058ae209","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"71"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"What are the rings around the piston for?","$type":"System.String"},"1st Correct answer":{"$content":"Sealing the gap so gas can''t leak past the piston","$type":"System.String"},"1st Correct answer feedback":{"$content":"Right! The springy rings press against the cylinder wall and keep the pressure on top of the piston.","$type":"System.String"},"1st Wrong answer":{"$content":"Holding the piston on the connecting rod","$type":"System.String"},"1st Wrong answer feedback":{"$content":"Close, but that''s the wrist pin through the middle of the piston.","$type":"System.String"},"2nd Wrong answer":{"$content":"Letting fresh mixture into the cylinder","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"No, that''s the intake valve''s job up in the head.","$type":"System.String"}},"position":{"x":12621.0,"y":0.0},"guid":"016692c6-4f9d-4724-8da4-6a330ce31fa5","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"73"},{"defaultValues":{"Insights":{"$content":"The piston''s highest point is called top dead centre, and its lowest is bottom dead centre. One trip between them is a stroke.","$type":"System.String"},"Audio clip":{"$content":6,"$type":"UnityEngine.Object"},"Image":{"$content":7,"$type":"UnityEngine.Object"}},"position":{"x":13236.5,"y":0.0},"guid":"a6f324f0-c13b-43a6-842d-9815647e9182","$version":"A","$type":"Visual_Scripting.Insights","$id":"75"},{"defaultValues":{"Instructions":{"$content":"Insert both valves into the head, in any order.","$type":"System.String"},"Progress percentage":{"$content":40,"$type":"System.Int32"}},"position":{"x":13682.5,"y":0.0},"guid":"cca725ec-74d3-41ca-accb-bedff47b8257","$version":"A","$type":"Visual_Scripting.Instructions","$id":"77"},{"defaultValues":{"Header text":{"$content":"Next is the piston","$type":"System.String"},"Feedback text":{"$content":"It''s the round, cup-shaped part with rings around it. It slides into the cylinder on top of the connecting rod, so combine it with the rod or the engine block.","$type":"System.String"}},"position":{"x":12114.0,"y":305.0},"guid":"579c2698-d5e7-42fd-bf63-9dc778630827","$version":"A","$type":"Visual_Scripting.Feedback","$id":"79"},{"actionChoice":"Combination","actionCount":4,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Intake valve","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Intake valve","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Piston","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Exhaust valve","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [4]":{"$content":"Exhaust valve","$type":"System.String"},"Correct stationary obj [4]":{"$content":"Piston","$type":"System.String"}},"position":{"x":14141.5,"y":0.0},"guid":"75b2e958-a5ed-4780-9227-ef08cb7b3e42","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"81"},{"defaultValues":{"Header text":{"$content":"Next are the two valves","$type":"System.String"},"Feedback text":{"$content":"They''re the two mushroom-shaped parts. They sit in the head above the cylinder, so combine each of them with the engine block, in any order.","$type":"System.String"}},"position":{"x":14568.0,"y":550.0},"guid":"01ad6b66-4573-4be6-baf5-546e0ac03d04","$version":"A","$type":"Visual_Scripting.Feedback","$id":"83"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Piston","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":8E-06,"y":0.246982,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":12182.5,"y":0.0},"guid":"fa3961a0-64e5-45b6-ad30-badf52c5a1ea","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"85"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Intake valve","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":-0.038981,"y":0.316777,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":14638.0,"y":0.0},"guid":"2c7ed622-28e6-4de4-afa3-166dbf777f76","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"87"},{"defaultValues":{"Insights":{"$content":"That mushroom-shaped valve is the intake. When the piston moves down, it opens and lets in fresh air with a fine mist of fuel.","$type":"System.String"},"Audio clip":{"$content":8,"$type":"UnityEngine.Object"},"Image":{"$content":9,"$type":"UnityEngine.Object"}},"position":{"x":15076.5,"y":0.0},"guid":"c5a467f5-e6f8-4f9c-b50a-c5b24a0b8e52","$version":"A","$type":"Visual_Scripting.Insights","$id":"89"},{"defaultValues":{"Instructions":{"$content":"Now insert the exhaust valve.","$type":"System.String"},"Progress percentage":{"$content":50,"$type":"System.Int32"}},"position":{"x":15535.5,"y":0.0},"guid":"8c3ce766-272d-4920-a33b-6bb3fad1b91e","$version":"A","$type":"Visual_Scripting.Instructions","$id":"91"},{"actionChoice":"Combination","actionCount":3,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Exhaust valve","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Exhaust valve","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Piston","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Exhaust valve","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Intake valve","$type":"System.String"}},"position":{"x":16032.5,"y":0.0},"guid":"18f32726-6c51-4ca8-9c3b-72b585086b3b","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"93"},{"defaultValues":{"Header text":{"$content":"Now the other valve","$type":"System.String"},"Feedback text":{"$content":"The exhaust valve is the smaller of the two mushroom-shaped parts. It goes into the head as well, so combine it with the engine block.","$type":"System.String"}},"position":{"x":16404.0,"y":405.0},"guid":"50af9568-5168-47dd-902f-2edd6d0e43f2","$version":"A","$type":"Visual_Scripting.Feedback","$id":"95"},{"defaultValues":{"Instructions":{"$content":"Lay both camshafts into their saddles on top, in any order.","$type":"System.String"},"Progress percentage":{"$content":60,"$type":"System.Int32"}},"position":{"x":16975.0,"y":0.0},"guid":"2e46716e-50cc-4cd2-8ba1-114be586bc96","$version":"A","$type":"Visual_Scripting.Instructions","$id":"97"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Exhaust valve","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.039657,"y":0.317097,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":14626.0,"y":266.0},"guid":"57930e1f-e351-49fc-81b8-18cdff5ba543","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"99"},{"defaultValues":{"Instructions":{"$content":"Now insert the intake valve, the bigger one.","$type":"System.String"},"Progress percentage":{"$content":50,"$type":"System.Int32"}},"position":{"x":15123.0,"y":574.0},"guid":"6c96fb4e-9906-455f-bb5b-beb8c5b66eb3","$version":"A","$type":"Visual_Scripting.Instructions","$id":"101"},{"actionChoice":"Combination","actionCount":3,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Intake valve","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Intake valve","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Piston","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Intake valve","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Exhaust valve","$type":"System.String"}},"position":{"x":15535.5,"y":882.0},"guid":"74c99944-1da7-40b6-919b-c94e1eca6e0c","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"103"},{"defaultValues":{"Header text":{"$content":"Now the other valve","$type":"System.String"},"Feedback text":{"$content":"The intake valve is the bigger of the two mushroom-shaped parts. It goes into the head as well, so combine it with the engine block.","$type":"System.String"}},"position":{"x":15942.0,"y":1281.0},"guid":"dbfe4cc7-ed10-4b30-856d-46c4728a10ec","$version":"A","$type":"Visual_Scripting.Feedback","$id":"105"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Intake valve","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":-0.038981,"y":0.316777,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":16032.5,"y":882.0},"guid":"375daab9-e78c-48df-9cc0-6fd92cd47704","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"107"},{"defaultValues":{"Insights":{"$content":"That mushroom-shaped valve is the intake. When the piston moves down, it opens and lets in fresh air with a fine mist of fuel.","$type":"System.String"},"Audio clip":{"$content":10,"$type":"UnityEngine.Object"},"Image":{"$content":11,"$type":"UnityEngine.Object"}},"position":{"x":16529.0,"y":882.0},"guid":"82ddeda3-6e33-480e-ada7-c36c1e5d0139","$version":"A","$type":"Visual_Scripting.Insights","$id":"109"},{"actionChoice":"Combination","actionCount":6,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Intake valve","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Exhaust valve","$type":"System.String"},"Correct grabbed obj [4]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [4]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [5]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [5]":{"$content":"Intake valve","$type":"System.String"},"Correct grabbed obj [6]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [6]":{"$content":"Exhaust valve","$type":"System.String"}},"position":{"x":17434.0,"y":0.0},"guid":"e528bf57-8dd4-4a3b-961e-ddee1ae4027b","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"111"},{"defaultValues":{"Header text":{"$content":"Next are the two camshafts","$type":"System.String"},"Feedback text":{"$content":"They''re the two shafts with an egg-shaped bump. They lie in the saddles on top of the head, right above the valves, so combine each with the engine block or a valve.","$type":"System.String"}},"position":{"x":17889.0,"y":577.0},"guid":"914c5133-a657-4137-aa38-5b1b8fe218d6","$version":"A","$type":"Visual_Scripting.Feedback","$id":"113"},{"defaultValues":{"Instructions":{"$content":"Now lay in the exhaust camshaft.","$type":"System.String"},"Progress percentage":{"$content":70,"$type":"System.Int32"}},"position":{"x":18388.5,"y":0.0},"guid":"e7e8c8b8-d96e-4d4a-b015-ffd13a221f68","$version":"A","$type":"Visual_Scripting.Instructions","$id":"115"},{"actionChoice":"Combination","actionCount":4,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Intake valve","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Exhaust valve","$type":"System.String"},"Correct grabbed obj [4]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct stationary obj [4]":{"$content":"Intake camshaft","$type":"System.String"}},"position":{"x":18847.5,"y":0.0},"guid":"5cea4dfe-84d8-441d-af44-9c49407b8d60","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"117"},{"defaultValues":{"Header text":{"$content":"Now the other camshaft","$type":"System.String"},"Feedback text":{"$content":"The exhaust camshaft lies above the exhaust valve, the smaller one. Combine it with the engine block or that valve.","$type":"System.String"}},"position":{"x":18847.5,"y":536.0},"guid":"3bb8aeba-ce20-462b-8afd-0ed10ff5367a","$version":"A","$type":"Visual_Scripting.Feedback","$id":"119"},{"defaultValues":{"Instructions":{"$content":"Put the piston into the cylinder, onto the connecting rod.","$type":"System.String"},"Progress percentage":{"$content":30,"$type":"System.Int32"}},"position":{"x":11220.0,"y":0.0},"guid":"89a4d091-b063-491e-b9d7-cb16e76eb5a7","$version":"A","$type":"Visual_Scripting.Instructions","$id":"121"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Exhaust camshaft","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.0625,"y":0.364535,"z":-0.0165,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":19364.0,"y":0.0},"guid":"5f9830d0-7de1-4bd8-89e0-fccd832d758f","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"123"},{"defaultValues":{"Header text":{"$content":"Next is the connecting rod","$type":"System.String"},"Feedback text":{"$content":"It''s the long rod with a big ring at one end and a small one at the other. The big ring goes around the crankpin, so combine it with the crankshaft or the engine block.","$type":"System.String"}},"position":{"x":10145.0,"y":293.0},"guid":"f3b6b476-b6ef-4903-8f81-ca49e0252de3","$version":"A","$type":"Visual_Scripting.Feedback","$id":"125"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Exhaust camshaft","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.0625,"y":0.364535,"z":-0.0165,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":17911.0,"y":274.0},"guid":"5ba3542a-468f-4bf0-9204-1b60d969da06","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"127"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Intake camshaft","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":-0.0625,"y":0.364535,"z":-0.0165,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":17950.0,"y":0.0},"guid":"1cbae19b-abbd-42ba-86c2-f479f5f89c9b","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"129"},{"actionChoice":"Combination","actionCount":4,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Intake valve","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Exhaust valve","$type":"System.String"},"Correct grabbed obj [4]":{"$content":"Intake camshaft","$type":"System.String"},"Correct stationary obj [4]":{"$content":"Exhaust camshaft","$type":"System.String"}},"position":{"x":18815.0,"y":786.0},"guid":"928741ba-a4fa-4343-b596-e4866d3d966a","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"131"},{"defaultValues":{"Insights":{"$content":"Now let''s see how it works! Interact with the engine to cycle through the four strokes, and I''ll explain each one along the way.","$type":"System.String"},"Audio clip":{"$content":12,"$type":"UnityEngine.Object"},"Image":{"$content":13,"$type":"UnityEngine.Object"}},"position":{"x":24352.0,"y":0.0},"guid":"f96cb7c0-0951-48e4-91a5-80d0f5fe590e","$version":"A","$type":"Visual_Scripting.Insights","$id":"133"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Intake camshaft","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":-0.0625,"y":0.364535,"z":-0.0165,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":19364.0,"y":882.0},"guid":"d3b9e1ea-4d29-42d5-a07f-f3e673dc4fc0","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"135"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"How fast do the camshafts turn compared with the crankshaft?","$type":"System.String"},"1st Correct answer":{"$content":"Half as fast","$type":"System.String"},"1st Correct answer feedback":{"$content":"Yes! Each valve opens only once every two crank turns, so the cams turn at half speed. In a real engine, a belt or chain from the crankshaft drives them.","$type":"System.String"},"1st Wrong answer":{"$content":"Just as fast","$type":"System.String"},"1st Wrong answer feedback":{"$content":"Then each valve would open every crank turn, twice as often as needed.","$type":"System.String"},"2nd Wrong answer":{"$content":"Twice as fast","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"The other way round. The cams turn at half the crank''s speed.","$type":"System.String"}},"position":{"x":19802.5,"y":0.0},"guid":"6ae9a1a0-f938-420e-969e-ebc6941b2eb6","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"137"},{"defaultValues":{"Insights":{"$content":"See those egg-shaped bumps? Those are cam lobes. As the camshaft turns, a lobe pushes its valve open, and a spring, which we left out here, closes it again.","$type":"System.String"},"Audio clip":{"$content":14,"$type":"UnityEngine.Object"},"Image":{"$content":15,"$type":"UnityEngine.Object"}},"position":{"x":20418.0,"y":0.0},"guid":"0ecfe1ce-7034-45d9-8656-edad50a27cb6","$version":"A","$type":"Visual_Scripting.Insights","$id":"139"},{"defaultValues":{"Instructions":{"$content":"Screw the spark plug into the top, between the valves.","$type":"System.String"},"Progress percentage":{"$content":80,"$type":"System.Int32"}},"position":{"x":20864.0,"y":0.0},"guid":"e61daaec-0413-4033-9c29-8ff870da9757","$version":"A","$type":"Visual_Scripting.Instructions","$id":"141"},{"actionChoice":"Combination","actionCount":5,"defaultValues":{"Correct grabbed obj [1]":{"$content":"Spark plug","$type":"System.String"},"Correct stationary obj [1]":{"$content":"Engine block","$type":"System.String"},"Correct grabbed obj [2]":{"$content":"Spark plug","$type":"System.String"},"Correct stationary obj [2]":{"$content":"Intake camshaft","$type":"System.String"},"Correct grabbed obj [3]":{"$content":"Spark plug","$type":"System.String"},"Correct stationary obj [3]":{"$content":"Exhaust camshaft","$type":"System.String"},"Correct grabbed obj [4]":{"$content":"Spark plug","$type":"System.String"},"Correct stationary obj [4]":{"$content":"Intake valve","$type":"System.String"},"Correct grabbed obj [5]":{"$content":"Spark plug","$type":"System.String"},"Correct stationary obj [5]":{"$content":"Exhaust valve","$type":"System.String"}},"position":{"x":21323.0,"y":0.0},"guid":"11de2ffb-3722-4642-a263-d439e5c7144b","$version":"A","$type":"Visual_Scripting.ActionFork","$id":"143"},{"defaultValues":{"Header text":{"$content":"Last is the spark plug","$type":"System.String"},"Feedback text":{"$content":"It''s the small part with the white ceramic body. It screws into the top of the head, between the valves, so combine it with the engine block.","$type":"System.String"}},"position":{"x":21790.0,"y":430.0},"guid":"8915ea17-8262-4c02-bc0a-fabe80e22dbe","$version":"A","$type":"Visual_Scripting.Feedback","$id":"145"},{"helperChoice":"FuseTwoObjects","defaultValues":{"Object name":{"$content":"Spark plug","$type":"System.String"},"Fuse to Object":{"$content":"Engine block","$type":"System.String"},"Offset Position":{"x":0.0,"y":0.318161,"z":0.0,"$type":"UnityEngine.Vector3"},"Offset Rotation":{"x":0.0,"y":180.0,"z":0.0,"$type":"UnityEngine.Vector3"}},"position":{"x":21839.5,"y":0.0},"guid":"d41d307a-f600-4a23-8090-8cd08fbefeeb","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"147"},{"defaultValues":{"Instructions":{"$content":"All parts are in: the engine is complete!","$type":"System.String"},"Progress percentage":{"$content":82,"$type":"System.Int32"}},"position":{"x":22278.0,"y":0.0},"guid":"23b91c99-ae19-4679-897c-fbd4331d564b","$version":"A","$type":"Visual_Scripting.Instructions","$id":"149"},{"defaultValues":{"Insights":{"$content":"That''s every part in, nice work! Fun fact: a German engineer named Otto built the first practical four-stroke engine in 1876. That''s why it''s called the Otto cycle.","$type":"System.String"},"Audio clip":{"$content":16,"$type":"UnityEngine.Object"},"Image":{"$content":17,"$type":"UnityEngine.Object"}},"position":{"x":22737.0,"y":0.0},"guid":"36c84d44-3fe0-4acb-9348-6bae867af6b9","$version":"A","$type":"Visual_Scripting.Insights","$id":"151"},{"defaultValues":{"duration":{"$content":11.6,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":23183.0,"y":0.0},"guid":"1d277428-58a1-419d-84fc-1123a6f4fe87","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"153"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine block","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":23562.0,"y":0.0},"guid":"29832eb1-ea99-4cc1-90cb-f08bfbc8bd7c","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"155"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":23957.0,"y":0.0},"guid":"b688680e-b785-4a78-81aa-4d7c8493f09f","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"157"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":24798.0,"y":0.0},"guid":"32b7b1ba-6d01-4bfc-b813-ccbc400a7cc4","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"159"},{"defaultValues":{"Insights":{"$content":"Compression! Both valves are shut, and the rising piston squeezes the mixture into the small chamber at the top.","$type":"System.String"},"Audio clip":{"$content":18,"$type":"UnityEngine.Object"},"Image":{"$content":19,"$type":"UnityEngine.Object"}},"position":{"x":29463.0,"y":0.0},"guid":"e928042a-f83d-4294-9f1d-22f2714e02fe","$version":"A","$type":"Visual_Scripting.Insights","$id":"161"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine","$type":"System.String"}},"position":{"x":25652.0,"y":0.0},"guid":"d8895d73-d80c-4bae-8543-3525b1093123","$version":"A","$type":"Visual_Scripting.Action","$id":"163"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to start the intake stroke.","$type":"System.String"}},"position":{"x":26068.0,"y":375.0},"guid":"77c704d3-de1f-4561-bfcc-3d631f2e8630","$version":"A","$type":"Visual_Scripting.Feedback","$id":"165"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":26117.5,"y":0.0},"guid":"c58ccc3a-0058-4b73-89ef-8a8d08765732","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"167"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (intake)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":26512.5,"y":0.0},"guid":"bccac437-3411-49f8-84b2-06945c251944","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"169"},{"defaultValues":{"Insights":{"$content":"Intake! The piston moves down and the intake valve opens. Air rushes in, and the fuel sprayed into the intake port comes along with it.","$type":"System.String"},"Audio clip":{"$content":20,"$type":"UnityEngine.Object"},"Image":{"$content":21,"$type":"UnityEngine.Object"}},"position":{"x":26907.5,"y":0.0},"guid":"2c2c3be9-ce42-444f-a708-08481cb5ecd0","$version":"A","$type":"Visual_Scripting.Insights","$id":"171"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine (intake)","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":27353.5,"y":0.0},"guid":"0f42bb51-a4ce-4c32-bb3b-6dade578cb78","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"173"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to see the compression stroke.","$type":"System.String"},"Progress percentage":{"$content":88,"$type":"System.Int32"}},"position":{"x":27748.5,"y":0.0},"guid":"8bdc0bb9-0c1d-4212-9728-518ac91f3bb1","$version":"A","$type":"Visual_Scripting.Instructions","$id":"175"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine (intake)","$type":"System.String"}},"position":{"x":28207.5,"y":0.0},"guid":"249c5ac6-ec24-49cb-b205-ff3f6a2bfafb","$version":"A","$type":"Visual_Scripting.Action","$id":"177"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to start the compression stroke.","$type":"System.String"}},"position":{"x":28583.0,"y":348.0},"guid":"db185925-064f-499b-b6a8-e58984ec9e53","$version":"A","$type":"Visual_Scripting.Feedback","$id":"179"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (intake)","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":28673.0,"y":0.0},"guid":"f64a5b90-ae2c-4acc-891c-82c31f8f5c8a","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"181"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (compression)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":29068.0,"y":0.0},"guid":"28be700d-1b40-4443-8eea-0b68c786efc8","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"183"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"When does the spark plug ignite the mixture?","$type":"System.String"},"1st Correct answer":{"$content":"At the end of compression, when the mixture is squeezed tight","$type":"System.String"},"1st Correct answer feedback":{"$content":"Correct! It fires just before the piston reaches the top, using many thousands of volts.","$type":"System.String"},"1st Wrong answer":{"$content":"At the start of the intake stroke","$type":"System.String"},"1st Wrong answer feedback":{"$content":"Too early. There''s no squeezed mixture in the cylinder yet.","$type":"System.String"},"2nd Wrong answer":{"$content":"During the exhaust stroke","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"Too late. That gas has already burned and is on its way out.","$type":"System.String"}},"position":{"x":32860.5,"y":0.0},"guid":"ba7d3198-7b56-4b9c-a057-3df7f3eaead2","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"185"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine (compression)","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":29909.0,"y":0.0},"guid":"5ce102a2-e3b4-4901-928d-174f19f7dc04","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"187"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to see the power stroke.","$type":"System.String"},"Progress percentage":{"$content":91,"$type":"System.Int32"}},"position":{"x":30304.0,"y":0.0},"guid":"2d1186b6-6776-47c5-a3a0-3bb75069367b","$version":"A","$type":"Visual_Scripting.Instructions","$id":"189"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to see the intake stroke.","$type":"System.String"},"Progress percentage":{"$content":85,"$type":"System.Int32"}},"position":{"x":25193.0,"y":0.0},"guid":"4522651e-ae74-4efb-983e-27c263bf6e8a","$version":"A","$type":"Visual_Scripting.Instructions","$id":"191"},{"defaultValues":{},"position":{"x":41865.0,"y":0.0},"guid":"f64b7121-7569-4c5e-b4a2-7ae7a4603fd5","$version":"A","$type":"Visual_Scripting.Conclusion","$id":"193"},{"defaultValues":{"Header text":{"$content":"Now the other camshaft","$type":"System.String"},"Feedback text":{"$content":"The intake camshaft lies above the intake valve, the bigger one. Combine it with the engine block or that valve.","$type":"System.String"}},"position":{"x":19378.0,"y":1191.0},"guid":"aa20c4bf-5d35-4a2c-af11-3fe35812ce1a","$version":"A","$type":"Visual_Scripting.Feedback","$id":"195"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine (compression)","$type":"System.String"}},"position":{"x":30763.0,"y":0.0},"guid":"d96c4568-1eae-4b18-848b-b566d7200012","$version":"A","$type":"Visual_Scripting.Action","$id":"197"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to start the power stroke.","$type":"System.String"}},"position":{"x":31220.0,"y":365.0},"guid":"cc621ebb-5bd4-4c39-9df2-5a14f8254647","$version":"A","$type":"Visual_Scripting.Feedback","$id":"199"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (compression)","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":31233.5,"y":0.0},"guid":"10e07a8b-5ac0-4fc7-9d8a-5a5490a55ba4","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"201"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (power)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":31628.5,"y":0.0},"guid":"15ff23e1-4f7a-47f8-8046-78ec66e4644d","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"203"},{"defaultValues":{"Insights":{"$content":"Ignition! The spark plug fires, the mixture burns in a flash, and the hot gas pushes the piston down hard. This is the only stroke that makes power.","$type":"System.String"},"Audio clip":{"$content":22,"$type":"UnityEngine.Object"},"Image":{"$content":23,"$type":"UnityEngine.Object"}},"position":{"x":32023.5,"y":0.0},"guid":"089f5da3-1e5d-4106-ab90-267f751d980e","$version":"A","$type":"Visual_Scripting.Insights","$id":"205"},{"defaultValues":{"duration":{"$content":10.025,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":32469.5,"y":0.0},"guid":"0ff2a7ce-d849-4121-a4bd-ff72bd2dbf28","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"207"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine (power)","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":33476.0,"y":0.0},"guid":"0b1a4502-7424-4bc3-b170-fb9c2e021095","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"209"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine (power)","$type":"System.String"}},"position":{"x":34330.0,"y":0.0},"guid":"71361221-c069-4798-baa4-8f1a9f456c58","$version":"A","$type":"Visual_Scripting.Action","$id":"211"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to start the exhaust stroke.","$type":"System.String"}},"position":{"x":34771.0,"y":409.0},"guid":"735c35c8-0541-4c44-b897-1c6126a995cb","$version":"A","$type":"Visual_Scripting.Feedback","$id":"213"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (power)","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":34795.5,"y":0.0},"guid":"5acb96df-8911-431f-bb67-9e177a22fafd","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"215"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (exhaust)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":35190.5,"y":0.0},"guid":"d96f9ec7-1ba5-48d0-b634-feca49dd1bbc","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"217"},{"defaultValues":{"Insights":{"$content":"Exhaust! The exhaust valve opens, and the rising piston pushes the burnt gas out. Then it all starts again with intake.","$type":"System.String"},"Audio clip":{"$content":24,"$type":"UnityEngine.Object"},"Image":{"$content":25,"$type":"UnityEngine.Object"}},"position":{"x":35585.5,"y":0.0},"guid":"b8616ce9-844b-4965-851d-874022934fbb","$version":"A","$type":"Visual_Scripting.Insights","$id":"219"},{"defaultValues":{"duration":{"$content":8.25,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":36031.5,"y":0.0},"guid":"999a61ff-0b26-43f1-87bc-de73c610b6ca","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"221"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to see the exhaust stroke.","$type":"System.String"},"Progress percentage":{"$content":94,"$type":"System.Int32"}},"position":{"x":33871.0,"y":0.0},"guid":"1ffd3d3c-9a1b-4764-a6a8-720e6c1ac3da","$version":"A","$type":"Visual_Scripting.Instructions","$id":"223"},{"helperChoice":"ToggleInteractable","defaultValues":{"Object name":{"$content":"Engine (exhaust)","$type":"System.String"},"Interactable":{"$content":true,"$type":"System.Boolean"}},"position":{"x":37026.0,"y":0.0},"guid":"11f0ec93-c9af-43d5-bcac-964a02a437db","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"225"},{"defaultValues":{"Instructions":{"$content":"Interact with the engine to start it!","$type":"System.String"},"Progress percentage":{"$content":97,"$type":"System.Int32"}},"position":{"x":37421.0,"y":0.0},"guid":"1af75c7d-6374-488c-b396-b16b370d4d64","$version":"A","$type":"Visual_Scripting.Instructions","$id":"227"},{"actionChoice":"Interaction","defaultValues":{"Correct object":{"$content":"Engine (exhaust)","$type":"System.String"}},"position":{"x":37880.0,"y":0.0},"guid":"9287b06c-f7a4-4903-8776-815ee3b12a3a","$version":"A","$type":"Visual_Scripting.Action","$id":"229"},{"defaultValues":{"Header text":{"$content":"Interact with the engine","$type":"System.String"},"Feedback text":{"$content":"Aim the crosshair at the engine and press the Interact button to start the engine.","$type":"System.String"}},"position":{"x":38372.0,"y":440.0},"guid":"e90a1faf-8f94-4e49-937d-1d4f91b81572","$version":"A","$type":"Visual_Scripting.Feedback","$id":"231"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (exhaust)","$type":"System.String"},"Visible":{"$content":false,"$type":"System.Boolean"}},"position":{"x":38345.5,"y":0.0},"guid":"665869e3-bad9-4f2f-bde1-6ad498f70bb2","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"233"},{"defaultValues":{"duration":{"$content":11.25,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":41022.0,"y":0.0},"guid":"6f542843-30e5-42cb-b65f-26372d9d57a2","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"235"},{"helperChoice":"ToggleVisibility","defaultValues":{"Object name":{"$content":"Engine (running)","$type":"System.String"},"Visible":{"$content":true,"$type":"System.Boolean"}},"position":{"x":38740.5,"y":0.0},"guid":"883cbbb3-6255-4969-8d9c-ad233df966c3","$version":"A","$type":"Visual_Scripting.ObjectHelper","$id":"237"},{"defaultValues":{"Insights":{"$content":"Here she goes! Intake, compression, power and exhaust, over and over again.","$type":"System.String"},"Audio clip":{"$content":26,"$type":"UnityEngine.Object"},"Image":{"$content":27,"$type":"UnityEngine.Object"}},"position":{"x":39135.5,"y":0.0},"guid":"02e20802-d6d7-480e-8d2a-8b27c6771834","$version":"A","$type":"Visual_Scripting.Insights","$id":"239"},{"defaultValues":{"Instructions":{"$content":"Well done! You built a four-stroke engine.","$type":"System.String"},"Progress percentage":{"$content":100,"$type":"System.Int32"}},"position":{"x":41406.0,"y":0.0},"guid":"ba56c022-39a6-479f-ac99-8abf06b9f625","$version":"A","$type":"Visual_Scripting.Instructions","$id":"241"},{"defaultValues":{"duration":{"$content":5.6,"$type":"System.Single"},"unscaledTime":{"$content":false,"$type":"System.Boolean"}},"position":{"x":39581.5,"y":0.0},"guid":"8fa6c520-16b4-4d1f-a8ce-c58598b55021","$version":"A","$type":"Unity.VisualScripting.Cooldown","$id":"243"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"How many crankshaft turns does one full four-stroke cycle take?","$type":"System.String"},"1st Correct answer":{"$content":"Two","$type":"System.String"},"1st Correct answer feedback":{"$content":"Right! Each stroke is half a turn, so four strokes make two full turns.","$type":"System.String"},"1st Wrong answer":{"$content":"One","$type":"System.String"},"1st Wrong answer feedback":{"$content":"Each stroke is half a turn, so four strokes need two turns.","$type":"System.String"},"2nd Wrong answer":{"$content":"Four","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"A stroke is only half a turn, not a whole one, so it''s two turns.","$type":"System.String"}},"position":{"x":39960.5,"y":0.0},"guid":"35315520-b9d5-454c-8ba2-f89c7ef7f728","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"245"},{"defaultValues":{"Insights":{"$content":"Great job, mechanic! Only one of the four strokes makes power. The spinning crankshaft''s momentum, plus a heavy flywheel on a real engine, carries it through the other three.","$type":"System.String"},"Audio clip":{"$content":28,"$type":"UnityEngine.Object"},"Image":{"$content":29,"$type":"UnityEngine.Object"}},"position":{"x":40576.0,"y":0.0},"guid":"dcf065a0-caef-4302-af3a-f72d774c7f62","$version":"A","$type":"Visual_Scripting.Insights","$id":"247"},{"actionChoice":"Questionnaire","correctAnswers":1,"wrongAnswers":2,"defaultValues":{"Question":{"$content":"When is the exhaust valve open?","$type":"System.String"},"1st Correct answer":{"$content":"When the piston moves up and pushes the burnt gas out","$type":"System.String"},"1st Correct answer feedback":{"$content":"Spot on! That''s the exhaust stroke. The rising piston pushes the burnt gas out through the open exhaust valve.","$type":"System.String"},"1st Wrong answer":{"$content":"When the piston moves down and draws fresh mixture in","$type":"System.String"},"1st Wrong answer feedback":{"$content":"That''s the intake stroke, when the intake valve lets fresh mixture in.","$type":"System.String"},"2nd Wrong answer":{"$content":"While the burning gas pushes the piston down","$type":"System.String"},"2nd Wrong answer feedback":{"$content":"No, during the power stroke the valves stay closed, so the pressure pushes the piston down. The exhaust valve only opens right near the bottom.","$type":"System.String"}},"position":{"x":36410.5,"y":0.0},"guid":"c5b01f3e-518f-4596-baa2-0d3a11a482a8","$version":"A","$type":"Visual_Scripting.ActionUI","$id":"249"},{"sourceUnit":{"$ref":"23"},"sourceKey":"","destinationUnit":{"$ref":"25"},"destinationKey":"","guid":"089acbaa-6d5b-4c5f-882f-a05e0db8d85e","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"Correct","destinationUnit":{"$ref":"23"},"destinationKey":"","guid":"fb0f7976-0772-4eba-b2cf-5740a210fbf5","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"19"},"sourceKey":"Incorrect","destinationUnit":{"$ref":"21"},"destinationKey":"","guid":"808a67ce-1897-4723-982b-c3276aded1ca","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"15"},"sourceKey":"","destinationUnit":{"$ref":"17"},"destinationKey":"","guid":"70332d4e-6cf5-4d4a-acbd-7aaf8af1f764","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"13"},"sourceKey":"","destinationUnit":{"$ref":"15"},"destinationKey":"","guid":"52e25db4-551a-4c27-b621-82bf6c60df8b","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"17"},"sourceKey":"","destinationUnit":{"$ref":"19"},"destinationKey":"","guid":"b79768a8-b41b-40ba-a34e-6a40328df3b1","$type":"Unity.VisualScripting.ControlConnection"},{"sourceUnit":{"$ref":"69"},"sourceKey":"Correct [1]","destinationUnit":{"$ref":"85"},"destinationKey":"","guid":"179b63de-d27b-41ca-9a94